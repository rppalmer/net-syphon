# Optional fallback configuration; environment variables take precedence.
# Save only under ~/.net-syphon/.env (directory 0700, file 0600).
# Set your existing instance base URL, not its /search endpoint. JSON must be enabled.
NET_SYPHON_SEARXNG_URL=http://192.0.2.10:8080
# Required for filtered/news search and page retrieval; set privately, never in git.
# NET_SYPHON_FIRECRAWL_API_KEY=your-key
